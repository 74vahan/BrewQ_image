# Local .env for docker compose. Real values live only in .env (git-ignored).
# On the server /srv/brewq/.env is written once by the Terraform bootstrap.
# Empty values here on purpose (rule 9): fill them in your own .env.

# MySQL. MYSQL_USER must not be "root". Passwords: letters and digits only
# (they go into DATABASE_URL without escaping).
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Barista panel login and token signing (any values for local dev;
# BARISTA_TOKEN_SECRET: at least 32 random characters).
BARISTA_PASSWORD=
BARISTA_TOKEN_SECRET=
# Optional, default 12.
BARISTA_TOKEN_TTL_HOURS=

# Host port of the backend on 127.0.0.1 (optional, default 8081).
BACKEND_PORT=
# Public origin used to build absolute URLs (menu images). Optional locally.
PUBLIC_BASE_URL=
# DEBUG | INFO | WARNING | ERROR (optional, default INFO).
LOG_LEVEL=

# Local only, optional: where the backend code and menu images live if the
# BrewQ_infra clone is not a sibling of this repository.
# BACKEND_CONTEXT=
# MEDIA_DIR_HOST=
